{
  "name": "MyVaravuSelavu",
  "short_name": "MVS",
  "description": "Personal income/expense tracker",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#111827",
  "theme_color": "#111827",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Add",
      "description": "Log a new expense right away",
      "url": "/?action=add",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Log commute",
      "short_name": "Commute",
      "description": "Today's bus trips and Pasmo balance",
      "url": "/commute",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Cash on hand",
      "short_name": "Cash",
      "description": "Count and tally your physical cash",
      "url": "/cash",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Who owes me",
      "short_name": "Owes me",
      "description": "Open the friend ledger",
      "url": "/friends",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
